# Byte-compiled / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Rust / maturin
rust/**/target/
**/*.so
**/*.pyd

# Virtual environments
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Data and outputs (keep repositories code-only)
data/
output/
*.pkl
*.jsonl
!examples/**/*.jsonl

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local e2e environment (machine-specific)
.venv-e2e/
.e2e-setup.log

# Runtime logs
logs/

# Local install scratch files
.vs-modify.bat
.vs-modify.ps1
.*-install.log
.vs-*.log
.l2-test.log
.l3-test.log
.e2e-all.log
.bench-test.log
.contradoc-probe.log

# Benchmark evaluation data is intentionally tracked (lab-approved release)
!benchmarks/data/
!benchmarks/data/**
