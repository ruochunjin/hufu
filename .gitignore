# Byte-compiled / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Rust / maturin
rust/**/target/
**/*.so
**/*.pyd

# Virtual environments
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Data and outputs (keep repositories code-only)
data/
output/
*.pkl
*.jsonl
!examples/**/*.jsonl

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local e2e environment (machine-specific)
.venv-e2e/
.e2e-setup.log

# Runtime logs
logs/

# Local install scratch files
.vs-modify.bat
.vs-modify.ps1
.*-install.log
.vs-*.log
.l2-test.log
.l3-test.log
.e2e-all.log
.bench-test.log
.contradoc-probe.log

# Benchmark evaluation data is intentionally tracked (lab-approved release)
!benchmarks/data/
!benchmarks/data/**

# Golden100 run report (regenerated each run)
tests/e2e/golden100_report.json
tests/e2e/golden250_report.json
tests/e2e/golden100_report_sm.json

# Regenerable caches (hypergraph pickles, dataset parquet downloads)
benchmarks/data/cache/hypergraphs/
benchmarks/data/cache/*--*/
tests/e2e/golden_doc_report.json

# Local run/probe logs and scratch outputs
.*.log
.*-probe.log
.std-*.txt
.conflict-features.json
.vs-*.log
.vs-*.bat
.vs-*.ps1
tests/e2e/golden_doc300_report.json
