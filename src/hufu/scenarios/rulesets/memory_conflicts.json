{
  "name": "memory_conflicts",
  "version": "2",
  "metadata": {
    "description": "CDR-style conflict detection rules for vector-store memories (embodied agents, RAG memory banks)",
    "source_paper": "Conflict-Aware Memory for Embodied Agents: Enhancing Vector Data Quality via Detection Rules (ACL 2026)",
    "changelog": "v2 (2026-10-08, golden-mem driven): action/state rules use attr_opposite (explicit opposite pairs + location-valued states) instead of any-difference attr_conflict; NLI fallback gated to unstructured memories (no object attribute) and now consumes softmax probabilities (was raw logits); vec_sim theta 0.5 -> 0.59 learned by Youden J on the 320-bank golden corpus (tpr=0.985 fpr=0.057, CDR calibration methodology)"
  },
  "rules": [
    {
      "id": "cdr.action_conflict",
      "if": [
        {
          "pred": "attr_equal",
          "attr": "object"
        },
        {
          "pred": "attr_opposite",
          "attr": "action",
          "opposites": [
            [
              "turn on",
              "turn off"
            ],
            [
              "on",
              "off"
            ],
            [
              "open",
              "close"
            ],
            [
              "start",
              "stop"
            ],
            [
              "lock",
              "unlock"
            ],
            [
              "enable",
              "disable"
            ],
            [
              "charge",
              "drain"
            ],
            [
              "charge",
              "discharge"
            ],
            [
              "deploy",
              "recall"
            ],
            [
              "fill",
              "empty"
            ],
            [
              "raise",
              "lower"
            ],
            [
              "increase",
              "decrease"
            ],
            [
              "activate",
              "deactivate"
            ],
            [
              "connect",
              "disconnect"
            ],
            [
              "mute",
              "unmute"
            ],
            [
              "play",
              "pause"
            ]
          ]
        },
        {
          "pred": "vec_sim",
          "threshold": 0.59
        }
      ],
      "then": {
        "label": "conflict"
      },
      "source": "manual",
      "description": "Same object, opposing actions, high vector similarity (e.g. 'turn on the light' vs 'turn off the light')"
    },
    {
      "id": "cdr.state_conflict",
      "if": [
        {
          "pred": "attr_equal",
          "attr": "object"
        },
        {
          "pred": "attr_opposite",
          "attr": "state",
          "opposites": [
            [
              "open",
              "closed"
            ],
            [
              "locked",
              "unlocked"
            ],
            [
              "hot",
              "cold"
            ],
            [
              "occupied",
              "vacant"
            ],
            [
              "full",
              "empty"
            ],
            [
              "on",
              "off"
            ],
            [
              "asleep",
              "awake"
            ],
            [
              "wet",
              "dry"
            ],
            [
              "clean",
              "dirty"
            ],
            [
              "online",
              "offline"
            ],
            [
              "available",
              "unavailable"
            ],
            [
              "free",
              "busy"
            ]
          ]
        },
        {
          "pred": "vec_sim",
          "threshold": 0.59
        }
      ],
      "then": {
        "label": "conflict"
      },
      "source": "manual",
      "description": "Same object with incompatible states ('door is open' vs 'door is closed'), or different location-valued states ('robot is in kitchen' vs 'in bedroom')"
    },
    {
      "id": "cdr.value_conflict",
      "if": [
        {
          "pred": "attr_equal",
          "attr": "object"
        },
        {
          "pred": "numeric_conflict",
          "attr": "value",
          "rel_tol": 0.05
        },
        {
          "pred": "vec_sim",
          "threshold": 0.59
        }
      ],
      "then": {
        "label": "conflict"
      },
      "source": "manual",
      "description": "Same object with materially different numeric values"
    },
    {
      "id": "rico.nli_contradiction",
      "if": [
        {
          "pred": "attr_present",
          "attr": "object",
          "negate": true
        },
        {
          "pred": "vec_sim",
          "threshold": 0.6
        },
        {
          "pred": "nli_contradicts",
          "threshold": 0.8
        }
      ],
      "then": {
        "label": "contradiction",
        "confidence": 0.9
      },
      "source": "manual",
      "description": "Unstructured fallback: only when at least one side carries no object attribute (structured rules govern attributed memories; NLI has no tolerance notion and double-fires otherwise)"
    }
  ]
}